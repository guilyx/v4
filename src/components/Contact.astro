---
import { contact, site } from "@/data/site";
---

<section id="contact" class="mx-auto max-w-xl scroll-mt-24 py-24 text-center md:py-36">
  <p class="font-mono text-accent mb-4 text-sm" data-reveal>{contact.kicker}</p>
  <h2 class="text-3xl font-semibold sm:text-4xl" data-reveal style="--reveal-delay: 100ms">
    {contact.title}
  </h2>
  <p class="text-body mt-6" data-reveal style="--reveal-delay: 200ms">
    {contact.body.replace(/\s+/g, " ")}
  </p>
  <div class="mt-12" data-reveal style="--reveal-delay: 300ms">
    <a href={`mailto:${site.email}`} class="btn">Say Hello</a>
  </div>
</section>
