---
import { nav, site } from "@/data/site";
---

<header id="site-nav" class="fixed inset-x-0 top-0 z-50 transition-transform duration-300 ease-out">
  <nav
    class="border-line/60 bg-bg/85 flex h-[72px] items-center justify-between border-b px-6 backdrop-blur-md sm:px-10"
    aria-label="Primary"
  >
    <a href="/" class="font-mono text-accent group flex items-center gap-2 text-sm" aria-label="Home">
      {/* A route through three waypoints — the brand mark. */}
      <svg
        width="28"
        height="28"
        viewBox="0 0 32 32"
        fill="none"
        class="transition-transform duration-500 group-hover:rotate-[120deg]"
        aria-hidden="true"
      >
        <path d="M16 8.5 L8.5 21 L23.5 21" stroke="currentColor" stroke-width="1.1" opacity="0.45"
        ></path>
        <g fill="currentColor">
          <circle cx="16" cy="8.5" r="2.1"></circle>
          <circle cx="8.5" cy="21" r="2.1"></circle>
          <circle cx="23.5" cy="21" r="2.1"></circle>
        </g>
      </svg>
      <span class="text-faint hidden lg:inline">{site.handle}</span>
    </a>

    <button
      id="nav-toggle"
      class="text-accent z-50 -mr-2 p-2 md:hidden"
      aria-label="Toggle menu"
      aria-expanded="false"
      aria-controls="nav-menu"
    >
      <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true">
        <path d="M3 6h18"></path>
        <path d="M3 12h18"></path>
        <path d="M3 18h18"></path>
      </svg>
    </button>

    {/* Desktop links live in the bar itself. */}
    <ol class="hidden items-center gap-8 md:flex">
      {
        nav.map((item) => (
          <li>
            <a href={item.href} class="font-mono text-body hover:text-accent text-sm transition-colors">
              {item.label}
            </a>
          </li>
        ))
      }
      <li>
        <a href={site.resume} target="_blank" rel="noopener noreferrer" class="btn !px-4 !py-2">
          résumé
        </a>
      </li>
    </ol>
  </nav>
</header>

{/*
  The mobile drawer is a sibling of <header>, not a child of <nav>, and that
  placement is load-bearing: `backdrop-blur` on the bar makes it the containing
  block for any `position: fixed` descendant, so a drawer nested inside it got
  sized to the 72px bar instead of the viewport — it opened as a stub with no
  background. Kept outside, it resolves against the viewport like it should.
*/}
<ol
  id="nav-menu"
  class="nav-drawer border-line bg-bg-raised fixed inset-y-0 right-0 z-40 flex w-[min(78vw,320px)] translate-x-full flex-col items-start justify-center gap-8 border-l px-10 shadow-2xl transition-transform duration-300 ease-out md:hidden"
>
  {
    nav.map((item) => (
      <li>
        <a href={item.href} class="font-mono text-body hover:text-accent text-base transition-colors">
          {item.label}
        </a>
      </li>
    ))
  }
  <li>
    <a href={site.resume} target="_blank" rel="noopener noreferrer" class="btn !px-4 !py-2">
      résumé
    </a>
  </li>
</ol>

<div id="nav-scrim" class="fixed inset-0 z-30 hidden bg-black/60 md:hidden"></div>

<style>
  /* Hide-on-scroll-down state (class toggled by script) */
  #site-nav.nav-hidden {
    transform: translateY(-100%);
  }

  /* Tailwind v4 builds `translate-x-full` on the standalone `translate`
     property rather than `transform`, so overriding `transform` alone left
     the drawer parked off-screen. Reset `translate`; `transform` is kept as
     a belt-and-braces reset for either build. */
  #nav-menu.menu-open {
    translate: 0 0;
    transform: none;
  }
  #nav-scrim.is-open {
    display: block;
  }

  @media (prefers-reduced-motion: reduce) {
    .nav-drawer {
      transition: none;
    }
  }
</style>

<script>
  const header = document.getElementById("site-nav")!;
  const toggle = document.getElementById("nav-toggle");
  const menu = document.getElementById("nav-menu");
  const scrim = document.getElementById("nav-scrim");

  // Hide nav when scrolling down, reveal when scrolling up.
  let lastY = window.scrollY;
  let ticking = false;
  window.addEventListener("scroll", () => {
    if (ticking) return;
    ticking = true;
    requestAnimationFrame(() => {
      const y = window.scrollY;
      const menuOpen = menu?.classList.contains("menu-open");
      if (!menuOpen) {
        if (y > lastY && y > 120) header.classList.add("nav-hidden");
        else header.classList.remove("nav-hidden");
      }
      lastY = y;
      ticking = false;
    });
  });

  function setMenu(open: boolean) {
    menu?.classList.toggle("menu-open", open);
    scrim?.classList.toggle("is-open", open);
    toggle?.setAttribute("aria-expanded", String(open));
    document.body.style.overflow = open ? "hidden" : "";
  }

  toggle?.addEventListener("click", () => setMenu(!menu?.classList.contains("menu-open")));
  scrim?.addEventListener("click", () => setMenu(false));
  menu?.querySelectorAll("a").forEach((a) => a.addEventListener("click", () => setMenu(false)));
  document.addEventListener("keydown", (e) => {
    if (e.key === "Escape") setMenu(false);
  });
</script>
