---
import { Image } from "astro:assets";
import Section from "@/components/Section.astro";
import Icon from "@/components/Icon.astro";
import { builds, layers, buildsIntro, site } from "@/data/site";
import setupPromo from "@/assets/projects/setup.png";

/** Promo artifact per build, keyed by `glyph` in site data. */
const promos = {
  provision: setupPromo,
} as const;

const githubUrl = site.socials.find((s) => s.icon === "github")?.url ?? `https://github.com/${site.handle}`;
---

<Section id="projects" title="Selected Builds">
  <p class="text-muted mb-10 max-w-xl text-sm" data-reveal>
    {buildsIntro.replace(/\s+/g, " ")}
  </p>

  <ul class="grid gap-5 sm:grid-cols-2 lg:grid-cols-4">
    {
      builds.map((p, i) => (
        <li data-reveal style={`--reveal-delay: ${(i % 4) * 80}ms`}>
          <article class="group border-line bg-bg-raised hover:border-accent/40 relative flex h-full flex-col overflow-hidden rounded-lg border transition-all duration-300 hover:-translate-y-1.5">
            {p.video ? (
              <div class="border-line aspect-video overflow-hidden border-b">
                <video
                  controls
                  preload="none"
                  poster={p.videoPoster}
                  class="h-full w-full object-cover"
                >
                  <source src={p.video} type="video/mp4" />
                </video>
              </div>
            ) : (
              p.glyph && (
                <div class="border-line aspect-video overflow-hidden border-b">
                  <Image
                    src={promos[p.glyph as keyof typeof promos]}
                    alt={`${p.title} preview`}
                    widths={[320, 640]}
                    sizes="(min-width: 1024px) 25vw, 50vw"
                    class="h-full w-full object-cover opacity-85 saturate-[0.85] transition duration-500 group-hover:opacity-100 group-hover:saturate-100"
                  />
                </div>
              )
            )}
            <div class="flex grow flex-col p-6">
              <header class="mb-4 flex items-center justify-between">
                <span class="font-mono text-accent text-[0.7rem]">{layers[p.layer]}</span>
                <div class="relative z-[1] flex items-center gap-3">
                  {p.closed && (
                    <span class="font-mono text-faint text-[0.68rem]" title="Closed source">
                      closed
                    </span>
                  )}
                  {p.github && (
                    <a
                      href={p.github}
                      target="_blank"
                      rel="noopener noreferrer"
                      aria-label={`${p.title} on GitHub`}
                      class="text-muted hover:text-accent transition-colors"
                    >
                      <Icon name="github" size={18} />
                    </a>
                  )}
                  {p.external && (
                    <a
                      href={p.external}
                      target="_blank"
                      rel="noopener noreferrer"
                      aria-label={`${p.title} external link`}
                      class="text-muted hover:text-accent transition-colors"
                    >
                      <Icon name="external" size={18} />
                    </a>
                  )}
                </div>
              </header>
              <h4 class="text-base font-medium">
                {p.github || p.external ? (
                  <a
                    href={p.github ?? p.external}
                    target="_blank"
                    rel="noopener noreferrer"
                    class="group-hover:text-accent transition-colors after:absolute after:inset-0"
                  >
                    {p.title}
                  </a>
                ) : (
                  p.title
                )}
              </h4>
              <p class="text-muted mt-2 grow text-sm">{p.blurb}</p>
              <ul class="mt-5 flex flex-wrap gap-x-3 gap-y-1">
                {p.tech.map((t) => (
                  <li class="chip">{t}</li>
                ))}
              </ul>
            </div>
          </article>
        </li>
      ))
    }
  </ul>

  <div class="mt-10 flex justify-center" data-reveal>
    <a href={githubUrl} target="_blank" rel="noopener noreferrer" class="btn">
      See more on GitHub
    </a>
  </div>
</Section>
