---
import Section from "@/components/Section.astro";
import Icon from "@/components/Icon.astro";
import GhStats from "@/components/GhStats.astro";
import { getCollection } from "astro:content";
import { featured, projects, archive, layers, projectsIntro, type Project } from "@/data/site";

/**
 * Featured Projects — side projects only. A flat carousel of the ones with a
 * demo, three to a view on wide screens (scroll-snap, so touch and trackpads
 * just work; the buttons page through for everyone else), then a short grid
 * of more open source, then the way out to the archive, the blog and photos.
 * On wide screens the carousel breaks out of the text column to give the
 * clips room.
 *
 * Clips are muted, load nothing until their slide is on screen, and play only
 * while it stays there. Reduced-motion visitors get the poster and native
 * controls instead.
 */
const total = featured.length;
const pad = (n: number) => String(n).padStart(2, "0");
const label = (p: Project) =>
  [p.isOrg ? "org" : (p.org ?? "personal"), p.layer && layers[p.layer]].filter(Boolean).join(" · ");

const [latestPost] = (await getCollection("blog", ({ data }) => !data.draft)).sort(
  (a, b) => b.data.date.valueOf() - a.data.date.valueOf(),
);
const photoCount = (await getCollection("photos")).length;
const elsewhere = [
  {
    href: "/archive",
    eyebrow: "/archive",
    title: "Every project",
    body: `All ${archive.length} of them, from papers to old portfolios. Sort and filter by year, org or stack.`,
  },
  {
    href: latestPost ? `/blog/${latestPost.id}/` : "/blog",
    eyebrow: "/blog · latest",
    title: latestPost?.data.title ?? "Field Notes",
    body: "Writing on planning, robotics software, and whatever I'm building.",
  },
  {
    href: "/photos",
    eyebrow: "/photos",
    title: "Through the Lens",
    body: `${photoCount} photos: places, light, and the occasional robot.`,
  },
];
---

<Section id="projects" title="Featured Projects">
  <p class="text-muted mb-10 max-w-xl text-sm" data-reveal>{projectsIntro.replace(/\s+/g, " ")}</p>

  <div class="bleed" data-reveal style="--reveal-delay: 100ms">
    <ul class="track" data-track tabindex="0" aria-label="Featured projects, scroll for more">
      {
        featured.map((p, i) => (
          <li class="slide flex flex-col" aria-roledescription="slide" aria-label={`${i + 1} of ${total}: ${p.title}`}>
            <div class="border-line bg-bg-raised overflow-hidden rounded-lg border">
              <video
                muted
                loop
                playsinline
                preload="none"
                poster={p.videoPoster}
                aria-label={`${p.title} demo`}
                class="block aspect-[16/10] w-full object-cover object-top"
                data-clip
              >
                <source src={p.video} type={p.videoType ?? "video/mp4"} />
              </video>
            </div>

            <p class="font-mono text-accent mt-5 text-[0.7rem]">{label(p)}</p>
            <h3 class="mt-1 text-xl font-semibold">
              <a
                href={p.external ?? p.github}
                target="_blank"
                rel="noopener noreferrer"
                class="hover:text-accent transition-colors"
              >
                {p.title}
              </a>
            </h3>
            <p class="text-body mt-2 text-[0.92rem]">{p.blurb}</p>
            <ul class="mt-4 flex flex-wrap gap-x-3 gap-y-1">
              {p.tech.map((t) => (
                <li class="chip">{t}</li>
              ))}
            </ul>
            <div class="mt-auto flex flex-wrap items-center gap-x-4 gap-y-2 pt-4">
              {p.github && (
                <a
                  href={p.github}
                  target="_blank"
                  rel="noopener noreferrer"
                  aria-label={`${p.title} on GitHub`}
                  class="text-muted hover:text-accent transition-colors"
                >
                  <Icon name="github" size={18} />
                </a>
              )}
              {p.external && (
                <a
                  href={p.external}
                  target="_blank"
                  rel="noopener noreferrer"
                  class="font-mono text-muted hover:text-accent inline-flex items-center gap-2 text-xs transition-colors"
                >
                  {p.externalLabel ?? "Visit"}
                  <Icon name="external" size={13} />
                </a>
              )}
              {p.github && <GhStats url={p.github} pushed />}
            </div>
          </li>
        ))
      }
    </ul>
    <div class="mt-4 flex items-center gap-4">
      <div class="bg-line h-px flex-1" aria-hidden="true">
        <span class="bg-accent block h-px w-0 transition-[width] duration-200" data-progress></span>
      </div>
      <span class="font-mono text-faint text-xs tabular-nums" data-counter aria-hidden="true">
        {pad(1)} / {pad(total)}
      </span>
      <button type="button" class="carousel-btn" data-prev aria-label="Previous projects">
        <Icon name="arrow" size={16} class="rotate-180" />
      </button>
      <button type="button" class="carousel-btn" data-next aria-label="Next projects">
        <Icon name="arrow" size={16} />
      </button>
    </div>
  </div>

  {/* More open source: a short grid, then the archive for everything else */}
  <h3 class="mt-20 text-lg font-medium" data-reveal>More open source</h3>
  <ul class="mt-6 grid gap-4 sm:grid-cols-2" data-reveal>
    {
      projects.map((p) => (
        <li class="card group border-line relative flex flex-col rounded-lg border p-5">
          <p class="font-mono text-faint text-[0.68rem]">{label(p)}</p>
          <h4 class="text-heading mt-1 text-[0.95rem] font-medium break-words">
            <a
              href={p.github ?? p.external}
              target="_blank"
              rel="noopener noreferrer"
              class="group-hover:text-accent transition-colors after:absolute after:inset-0"
            >
              {p.title}
            </a>
          </h4>
          <p class="text-muted mt-2 text-sm">{p.blurb}</p>
          <div class="mt-auto flex flex-wrap items-center gap-x-4 gap-y-2 pt-4">
            <ul class="flex flex-wrap gap-x-3 gap-y-1">
              {p.tech.map((t) => (
                <li class="chip">{t}</li>
              ))}
            </ul>
            <div class="relative z-[1] ml-auto flex items-center gap-3">
              {p.github && <GhStats url={p.github} />}
              {p.github && p.external && (
                <a
                  href={p.external}
                  target="_blank"
                  rel="noopener noreferrer"
                  aria-label={`${p.title} site`}
                  class="text-muted hover:text-accent transition-colors"
                >
                  <Icon name="external" size={15} />
                </a>
              )}
            </div>
          </div>
        </li>
      ))
    }
  </ul>

  <h3 class="mt-20 text-lg font-medium" data-reveal>Keep exploring</h3>
  <ul class="mt-6 grid gap-4 sm:grid-cols-3" data-reveal>
    {
      elsewhere.map((e) => (
        <li class="card group border-line relative flex flex-col rounded-lg border p-5">
          <p class="font-mono text-accent text-[0.68rem]">{e.eyebrow}</p>
          <h4 class="text-heading mt-2 text-[0.95rem] font-medium">
            <a href={e.href} class="group-hover:text-accent transition-colors after:absolute after:inset-0">
              {e.title}
            </a>
          </h4>
          <p class="text-muted mt-2 text-sm">{e.body}</p>
          <span class="text-muted group-hover:text-accent mt-auto pt-4 transition-colors" aria-hidden="true">
            <Icon name="arrow" size={16} />
          </span>
        </li>
      ))
    }
  </ul>
</Section>

<style>
  /* From tablets up, the carousel breaks out of the text column and runs
     nearly edge to edge, up to 1360px, so the clips get room. The 2.5rem a
     side also covers a classic scrollbar counted inside 100vw. */
  @media (min-width: 768px) {
    .bleed {
      margin-inline: calc(50% - min(50vw - 2.5rem, 680px));
    }
  }

  .track {
    position: relative;
    display: flex;
    gap: 1.5rem;
    overflow-x: auto;
    overscroll-behavior-x: contain;
    scroll-snap-type: x mandatory;
    scroll-behavior: smooth;
    scrollbar-width: none;
    padding-bottom: 1rem;
  }
  .track::-webkit-scrollbar {
    display: none;
  }
  .track:focus-visible {
    outline: 2px dashed var(--color-accent);
    outline-offset: 6px;
  }
  /* On phones, a peek of the next slide says "there's more" without a word. */
  .slide {
    flex: 0 0 86%;
    scroll-snap-align: start;
  }
  @media (min-width: 640px) {
    .slide {
      flex-basis: calc((100% - 1.5rem) / 2);
    }
  }
  /* Three to a view only once each card can stay big. */
  @media (min-width: 1200px) {
    .slide {
      flex-basis: calc((100% - 3rem) / 3);
    }
  }

  .carousel-btn {
    display: inline-grid;
    place-items: center;
    width: 2.25rem;
    height: 2.25rem;
    border: 1px solid var(--color-line);
    border-radius: 999px;
    color: var(--color-body);
    transition:
      color 0.2s var(--ease-swift),
      border-color 0.2s var(--ease-swift),
      opacity 0.2s var(--ease-swift);
  }
  .carousel-btn:hover:not(:disabled),
  .carousel-btn:focus-visible {
    color: var(--color-accent);
    border-color: var(--color-accent);
  }
  .carousel-btn:disabled {
    opacity: 0.35;
    cursor: default;
  }

  .card {
    transition:
      background-color 0.2s var(--ease-swift),
      border-color 0.2s var(--ease-swift);
  }
  .card:hover {
    background-color: var(--color-accent-soft);
    border-color: color-mix(in srgb, var(--color-accent) 40%, var(--color-line));
  }

  @media (prefers-reduced-motion: reduce) {
    .track {
      scroll-behavior: auto;
    }
  }
</style>

<script>
  const track = document.querySelector<HTMLElement>("[data-track]");
  if (track) {
    const slides = Array.from(track.querySelectorAll<HTMLElement>(".slide"));
    const prev = document.querySelector<HTMLButtonElement>("[data-prev]")!;
    const next = document.querySelector<HTMLButtonElement>("[data-next]")!;
    const counter = document.querySelector<HTMLElement>("[data-counter]");
    const progress = document.querySelector<HTMLElement>("[data-progress]");
    const reduced = window.matchMedia("(prefers-reduced-motion: reduce)").matches;
    const pad = (n: number) => String(n).padStart(2, "0");

    /** The slide whose left edge is nearest the track's scroll position. */
    const current = () => {
      let best = 0;
      slides.forEach((s, i) => {
        if (Math.abs(s.offsetLeft - track.scrollLeft) < Math.abs(slides[best].offsetLeft - track.scrollLeft)) best = i;
      });
      return best;
    };

    /** How many slides fit in the track at once: 3, 2 or 1 by breakpoint. */
    const perView = () => {
      const gap = parseFloat(getComputedStyle(track).columnGap) || 0;
      const w = slides[0].getBoundingClientRect().width;
      return Math.max(1, Math.round((track.clientWidth + gap) / (w + gap)));
    };

    const update = () => {
      const max = track.scrollWidth - track.clientWidth;
      const atEnd = track.scrollLeft >= max - 2;
      const n = perView();
      const first = atEnd ? Math.max(0, slides.length - n) : current();
      const last = Math.min(slides.length, first + n);
      if (counter)
        counter.textContent =
          n > 1
            ? `${pad(first + 1)}–${pad(last)} / ${pad(slides.length)}`
            : `${pad(first + 1)} / ${pad(slides.length)}`;
      if (progress) progress.style.width = `${max > 0 ? (track.scrollLeft / max) * 100 : 100}%`;
      prev.disabled = track.scrollLeft <= 2;
      next.disabled = atEnd;
    };

    const go = (dir: number) => {
      const i = Math.max(0, Math.min(slides.length - 1, current() + dir * perView()));
      track.scrollTo({ left: slides[i].offsetLeft });
    };

    prev.addEventListener("click", () => go(-1));
    next.addEventListener("click", () => go(1));
    let ticking = false;
    track.addEventListener(
      "scroll",
      () => {
        if (ticking) return;
        ticking = true;
        requestAnimationFrame(() => {
          update();
          ticking = false;
        });
      },
      { passive: true },
    );
    window.addEventListener("resize", update);
    update();

    // Clips: play while their slide is mostly on screen, pause otherwise.
    const clips = Array.from(track.querySelectorAll<HTMLVideoElement>("[data-clip]"));
    if (reduced) {
      clips.forEach((v) => (v.controls = true));
    } else if ("IntersectionObserver" in window) {
      const io = new IntersectionObserver(
        (entries) => {
          for (const e of entries) {
            const v = e.target as HTMLVideoElement;
            if (e.isIntersecting) v.play().catch(() => (v.controls = true));
            else v.pause();
          }
        },
        { threshold: 0.6 },
      );
      clips.forEach((v) => io.observe(v));
      // A click toggles, for anyone who wants to stop the motion.
      clips.forEach((v) => v.addEventListener("click", () => (v.paused ? v.play() : v.pause())));
    }
  }
</script>
