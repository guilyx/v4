---
import Section from "@/components/Section.astro";
import { experience, TIMELINE_START } from "@/data/site";

/**
 * Trajectory — a timeline rather than a tab list, because roles run
 * concurrently and a tab list hides that entirely. One row per company;
 * each row can carry multiple selectable bars, one per stint, so a set of
 * promotions at the same company reads as distinct segments on one line
 * instead of duplicate rows.
 */
const now = 2026.6;
const span = now - TIMELINE_START;
const pct = (year: number) => ((year - TIMELINE_START) / span) * 100;
const ticks = [2018, 2020, 2022, 2024, 2026];

// Group stints by company, preserving one row per company.
const byCompany = new Map<string, typeof experience>();
for (const job of experience) {
  const list = byCompany.get(job.company) ?? [];
  list.push(job);
  byCompany.set(job.company, list);
}

// Order rows by the most recent activity in that company, most recent first.
const groups = [...byCompany.entries()]
  .map(([company, jobs]) => ({
    company,
    jobs: [...jobs].sort((a, b) => a.start - b.start),
    latest: Math.max(...jobs.map((j) => j.end ?? now)),
  }))
  .sort((a, b) => b.latest - a.latest);

// Flat, globally-ordered index shared by the bars above and the panels below,
// so the two lists stay in lockstep for tab/panel wiring and keyboard nav.
let cursor = 0;
const groupsIndexed = groups.map((g) => ({
  ...g,
  jobs: g.jobs.map((job) => ({ job, index: cursor++ })),
}));
const flat = groupsIndexed.flatMap((g) => g.jobs);
---

<Section id="experience" title="Trajectory">
  <div data-reveal>
    <p class="text-muted mb-8 max-w-xl text-sm">
      Eight years, four countries, one thread running through it: what should
      this system do next. Select a bar for the detail.
    </p>

    <div class="scroller -mx-2 overflow-x-auto px-2 pb-2">
      <div class="min-w-[540px]">
        {/* Year axis, offset to sit over the track only */}
        <div class="grid grid-cols-[104px_1fr] items-end" aria-hidden="true">
          <span></span>
          <div class="border-line relative h-5 border-b">
            {
              ticks.map((t) => (
                <span
                  class="font-mono text-faint absolute top-0 text-[0.65rem]"
                  style={`left: ${pct(t)}%; transform: translateX(${t === ticks[0] ? "0" : "-50%"})`}
                >
                  {t}
                </span>
              ))
            }
          </div>
        </div>

        {/* Rows: one per company, each with one bar per stint */}
        <div role="tablist" aria-label="Roles" class="mt-2 flex flex-col gap-1" id="tl">
          {
            groupsIndexed.map((group) => (
              <div class="grid w-full grid-cols-[104px_1fr] items-center gap-3 py-1">
                <span class="tl-label font-mono flex items-center gap-1.5 truncate pl-1 text-[0.7rem]">
                  <span
                    class="tl-icon border-line bg-bg inline-flex size-[18px] shrink-0 items-center justify-center rounded-[3px] border text-[0.55rem] leading-none"
                    aria-hidden="true"
                  >
                    {group.company.charAt(0)}
                  </span>
                  <span class="truncate">{group.jobs[0]!.job.shortName}</span>
                </span>
                <span class="relative block h-5">
                  {
                    group.jobs.map(({ job, index }) => {
                      const left = pct(job.start);
                      const right = pct(job.end ?? now);
                      return (
                        <button
                          role="tab"
                          id={`tl-tab-${index}`}
                          aria-controls={`tl-panel-${index}`}
                          aria-selected={index === 0 ? "true" : "false"}
                          tabindex={index === 0 ? 0 : -1}
                          aria-label={`${job.role} at ${job.company}, ${job.period}`}
                          class="tl-bar absolute top-1/2 -translate-y-1/2 rounded-[2px]"
                          style={`left: ${left}%; width: ${Math.max(right - left, 1.5)}%`}
                        >
                          <span class="tl-fill block h-2.5 rounded-[2px] transition-colors duration-200" />
                          {job.end === null && (
                            <span class="tl-live absolute top-1/2 -translate-y-1/2 text-[0.7rem] leading-none" style="left: calc(100% + 5px)">
                              →
                            </span>
                          )}
                        </button>
                      );
                    })
                  }
                </span>
              </div>
            ))
          }
        </div>
      </div>
    </div>

    {/* Detail panels */}
    <div class="border-line mt-8 min-h-[260px] border-t pt-8">
      {
        flat.map(({ job, index }) => (
          <div
            role="tabpanel"
            id={`tl-panel-${index}`}
            aria-labelledby={`tl-tab-${index}`}
            hidden={index !== 0}
            class="tl-panel"
          >
            <h3 class="flex flex-wrap items-center gap-2.5 text-lg font-medium sm:text-xl">
              <span
                class="border-line bg-bg inline-flex size-6 shrink-0 items-center justify-center rounded border text-[0.6rem] font-mono"
                aria-hidden="true"
              >
                {job.company.charAt(0)}
              </span>
              <span>
                {job.role}{" "}
                <span class="text-accent">
                  @{" "}
                  <a href={job.url} target="_blank" rel="noopener noreferrer" class="link">
                    {job.company}
                  </a>
                </span>
              </span>
            </h3>
            <p class="font-mono text-muted mt-1 text-xs">
              {job.period}
              {job.location && <span class="text-faint"> · {job.location}</span>}
            </p>
            <ul class="mt-6 space-y-3">
              {job.bullets.map((b) => (
                <li class="flex gap-3 text-[0.95rem]">
                  <span class="text-accent mt-1 shrink-0" aria-hidden="true">
                    ▸
                  </span>
                  <span>{b}</span>
                </li>
              ))}
            </ul>
          </div>
        ))
      }
    </div>
  </div>
</Section>

<style>
  .tl-fill {
    background: var(--color-line);
  }
  .tl-label {
    color: var(--color-muted);
  }
  .tl-bar:hover .tl-fill {
    background: color-mix(in srgb, var(--color-accent) 55%, var(--color-line));
  }
  .tl-bar[aria-selected="true"] .tl-fill {
    background: var(--color-accent);
  }
  .tl-live {
    color: var(--color-faint);
  }
  .tl-bar[aria-selected="true"] .tl-live {
    color: var(--color-accent);
  }
  .tl-panel {
    animation: tl-in 0.3s var(--ease-swift);
  }
  @keyframes tl-in {
    from {
      opacity: 0;
      transform: translateY(6px);
    }
    to {
      opacity: 1;
      transform: none;
    }
  }
  @media (prefers-reduced-motion: reduce) {
    .tl-panel {
      animation: none;
    }
    .tl-fill {
      transition: none;
    }
  }
</style>

<script>
  const tabs = Array.from(document.querySelectorAll<HTMLButtonElement>(".tl-bar"));
  const panels = Array.from(document.querySelectorAll<HTMLElement>(".tl-panel"));

  function select(index: number) {
    tabs.forEach((t, i) => {
      t.setAttribute("aria-selected", String(i === index));
      t.tabIndex = i === index ? 0 : -1;
    });
    panels.forEach((p, i) => {
      p.hidden = i !== index;
    });
  }

  tabs.forEach((tab, i) => {
    tab.addEventListener("click", () => select(i));
    tab.addEventListener("keydown", (e) => {
      let next = -1;
      if (e.key === "ArrowDown" || e.key === "ArrowRight") next = (i + 1) % tabs.length;
      if (e.key === "ArrowUp" || e.key === "ArrowLeft") next = (i - 1 + tabs.length) % tabs.length;
      if (next >= 0) {
        e.preventDefault();
        select(next);
        tabs[next]?.focus();
      }
    });
  });
</script>
