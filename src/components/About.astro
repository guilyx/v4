---
import Section from "@/components/Section.astro";
import Evolution from "@/components/Evolution.astro";
import { about } from "@/data/site";

/**
 * Tiny markdown-link renderer for the about paragraphs. Links are
 * inline-block, so a line could break between one and the punctuation after
 * it; a nowrap span keeps the two together.
 */
function md(text: string): string {
  return text.replace(/\s+/g, " ").replace(/\[([^\]]+)\]\(([^)]+)\)([.,;:]?)/g, (_, label, href, punct) => {
    const a = `<a href="${href}" target="_blank" rel="noopener noreferrer" class="link">${label}</a>`;
    return punct ? `<span class="whitespace-nowrap">${a}${punct}</span>` : a;
  });
}
---

{/* A few lines about me, then the chapters that got me here, sized to fit one
    screen on a laptop. The photo is in the hero; the tools list closes the
    Experiences section. */}
<Section id="about" title="Background">
  {/* Two short paragraphs, side by side on wide screens: shorter, and an
      easier line length than one paragraph across the whole column. */}
  <div class="space-y-4 lg:grid lg:grid-cols-2 lg:gap-10 lg:space-y-0" data-reveal>
    {about.paragraphs.map((p) => <p set:html={md(p)} />)}
  </div>

  <div class="mt-7">
    <Evolution />
  </div>
</Section>
