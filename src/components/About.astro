---
import Section from "@/components/Section.astro";
import Evolution from "@/components/Evolution.astro";
import { about } from "@/data/site";

/**
 * Tiny markdown-link renderer for the about paragraphs. Links are
 * inline-block, so a line could break between one and the punctuation after
 * it; a nowrap span keeps the two together.
 */
function md(text: string): string {
  return text.replace(/\s+/g, " ").replace(/\[([^\]]+)\]\(([^)]+)\)([.,;:]?)/g, (_, label, href, punct) => {
    const a = `<a href="${href}" target="_blank" rel="noopener noreferrer" class="link">${label}</a>`;
    return punct ? `<span class="whitespace-nowrap">${a}${punct}</span>` : a;
  });
}
---

{/* A few lines about me, then the chapters that got me here. The photo is in
    the hero now. */}
<Section id="about" title="Background">
  <div class="max-w-2xl space-y-4" data-reveal>
    {about.paragraphs.map((p) => <p set:html={md(p)} />)}
  </div>

  <div class="mt-14">
    <Evolution />
  </div>

  <div class="border-line mt-14 border-t pt-8" data-reveal>
    <p class="font-mono text-faint mb-4 text-xs">what I work with</p>
    <ul class="flex flex-wrap gap-2">
      {about.technologies.map((t) => <li class="tech">{t}</li>)}
    </ul>
  </div>
</Section>

<style>
  .tech {
    padding: 0.2rem 0.6rem;
    border: 1px solid var(--color-line);
    border-radius: 999px;
    font-family: var(--font-mono);
    font-size: 0.72rem;
    color: var(--color-muted);
  }
</style>
