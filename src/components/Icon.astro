  linkedin:
    "M20.45 20.45h-3.55v-5.57c0-1.33-.03-3.04-1.85-3.04-1.86 0-2.14 1.45-2.14 2.94v5.67H9.35V9h3.41v1.56h.05c.48-.9 1.64-1.85 3.37-1.85 3.6 0 4.27 2.37 4.27 5.46v6.28ZM5.34 7.43a2.06 2.06 0 1 1 0-4.12 2.06 2.06 0 0 1 0 4.12ZM7.12 20.45H3.56V9h3.56v11.45Z",
  // researchgate is rendered as a text badge below, not a path
  spotify:
    "M12 .5C5.65.5.5 5.65.5 12S5.65 23.5 12 23.5 23.5 18.35 23.5 12 18.35.5 12 .5Zm5.27 16.6a.72.72 0 0 1-.99.24c-2.7-1.65-6.1-2.02-10.11-1.1a.72.72 0 1 1-.32-1.4c4.38-1 8.14-.57 11.18 1.28.34.2.45.65.24.98Zm1.4-3.13a.9.9 0 0 1-1.23.3c-3.09-1.9-7.8-2.45-11.45-1.34a.9.9 0 1 1-.52-1.72c4.18-1.27 9.36-.65 12.9 1.53.42.26.56.81.3 1.23Zm.13-3.26C15.11 8.51 9 8.31 5.46 9.38a1.08 1.08 0 1 1-.63-2.06c4.07-1.24 10.83-1 15.1 1.53a1.08 1.08 0 0 1-1.13 1.86Z",
  external:
    "M18 13.5V19a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V8a2 2 0 0 1 2-2h5.5M15 3h6v6M10 14 21 3",
  folder:
    "M22 19a2 2 0 0 1-2 2H4a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h5l2 3h9a2 2 0 0 1 2 2v11Z",
  mail: "M4 4h16a2 2 0 0 1 2 2v12a2 2 0 0 1-2 2H4a2 2 0 0 1-2-2V6a2 2 0 0 1 2-2Zm18 3-10 6L2 7",
  arrow: "M5 12h14M13 6l6 6-6 6",
};

const stroked = ["external", "folder", "mail", "arrow"];
const d = paths[name];
---

{
  name === "researchgate" && (
    <svg
      width={size}
      height={size}
      viewBox="0 0 24 24"
      class={className}
      fill="none"
      aria-hidden="true"
    >
      <rect
        x="1.5"
        y="1.5"
        width="21"
        height="21"
        rx="4.5"
        stroke="currentColor"
        stroke-width="1.8"
      />
      <text
        x="12"
        y="16.3"
        text-anchor="middle"
        fill="currentColor"
        font-size="10.5"
        font-weight="600"
        font-family="ui-monospace, monospace"
      >
        RG
      </text>
    </svg>
  )
}
{
  d && (
    <svg
      width={size}
      height={size}
      viewBox="0 0 24 24"
      class={className}
      fill={stroked.includes(name) ? "none" : "currentColor"}
      stroke={stroked.includes(name) ? "currentColor" : "none"}
      stroke-width={stroked.includes(name) ? 1.7 : 0}
      stroke-linecap="round"
      stroke-linejoin="round"
      aria-hidden="true"
    >
      <path d={d} />
    </svg>
  )
}
