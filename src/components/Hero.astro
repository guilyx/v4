---
import { site, spec } from "@/data/site";
---

<section class="relative flex min-h-screen flex-col justify-center">
  {/* Grid search visualization — full-bleed behind the hero copy */}
  <canvas
    id="pathgrid"
    class="pointer-events-none absolute top-0 left-1/2 -z-[1] h-full w-screen -translate-x-1/2"
    aria-hidden="true"></canvas>

  <div class="max-w-3xl">
    <h1
      class="text-3xl font-semibold sm:text-5xl md:text-6xl"
      data-reveal
      style="--reveal-delay: 100ms"
    >
      {site.name}
    </h1>
    <h2
      class="text-muted mt-2 max-w-2xl text-2xl font-semibold sm:text-4xl"
      data-reveal
      style="--reveal-delay: 200ms"
    >
      {site.tagline}
    </h2>

    {/* Spec block — Erwin introduces himself as a YAML doc on GitHub; the
        site borrows that register rather than a greeting. */}
    <dl class="mt-9 grid max-w-lg gap-y-1.5" data-reveal style="--reveal-delay: 350ms">
      {
        spec.map((row) => (
          <div class="flex gap-4 font-mono text-[0.78rem] leading-relaxed">
            <dt class="text-faint w-20 shrink-0">{row.key}</dt>
            <dd class="text-body m-0">{row.value}</dd>
          </div>
        ))
      }
    </dl>

    <p class="chip mt-8 max-w-md" data-reveal style="--reveal-delay: 500ms">
      the grid behind this text is a live A* search — the same kind of graph
      the rest of the site runs on, just drawn out where you can watch it think.
    </p>

    <div class="mt-9 flex flex-wrap items-center gap-5" data-reveal style="--reveal-delay: 600ms">
      <a href="/#projects" class="btn">See the work</a>
      <a href={`mailto:${site.email}`} class="link font-mono text-sm">{site.email}</a>
    </div>
  </div>

  <a
    href="/#about"
    class="text-faint hover:text-accent absolute bottom-8 left-1/2 hidden -translate-x-1/2 transition-colors sm:block"
    aria-label="Scroll to about section"
    data-reveal
    style="--reveal-delay: 1200ms"
  >
    <svg
      width="22"
      height="22"
      viewBox="0 0 24 24"
      fill="none"
      stroke="currentColor"
      stroke-width="1.7"
      stroke-linecap="round"
      stroke-linejoin="round"
      class="animate-bounce"
      aria-hidden="true"
    >
      <path d="M12 4v16m-6-6 6 6 6-6"></path>
    </svg>
  </a>
</section>

<script>
  // ---------------------------------------------------------------------
  // A live A* search over a random grid — separation/alignment/cohesion
  // swapped for the thing this site is actually about: given a start, a
  // goal, and a field of obstacles, find the route. Frontier expands node
  // by node, a path gets traced, then the grid regenerates and it goes
  // again.
  // ---------------------------------------------------------------------
  const canvas = document.getElementById("pathgrid") as HTMLCanvasElement | null;

  if (canvas) {
    const ctx = canvas.getContext("2d")!;
    const reduceMotion = window.matchMedia("(prefers-reduced-motion: reduce)").matches;

    // Texture, not decoration — colours come from CSS tokens so palettes
    // swap cleanly in one place.
    function tokenRGB(name: string, fallback: string): string {
      const token = getComputedStyle(document.documentElement).getPropertyValue(name).trim();
      const hex = /^#?([\da-f]{2})([\da-f]{2})([\da-f]{2})$/i.exec(token);
      return hex
        ? `${parseInt(hex[1]!, 16)}, ${parseInt(hex[2]!, 16)}, ${parseInt(hex[3]!, 16)}`
        : fallback;
    }
    const GRAPH = tokenRGB("--color-graph", "124, 130, 145");
    const ACCENT = tokenRGB("--color-accent", "139, 149, 240");

    const CELL = 26;
    const STEPS_PER_FRAME = 5;
    const PATH_REVEAL_PER_FRAME = 2;
    const HOLD_FRAMES = 100;

    let w = 0;
    let h = 0;
    let dpr = 1;
    let cols = 0;
    let rows = 0;

    let walls: Uint8Array = new Uint8Array(0);
    let gScore: Float64Array = new Float64Array(0);
    let fScore: Float64Array = new Float64Array(0);
    let cameFrom: Int32Array = new Int32Array(0);
    let state: Uint8Array = new Uint8Array(0); // 0 unseen, 1 open, 2 closed
    let closedOrder: number[] = [];
    let openSet: number[] = [];
    let start = 0;
    let goal = 0;
    let path: number[] = [];
    let revealed = 0;
    let hold = 0;
    let phase: "search" | "path" | "hold" = "search";

    const idx = (x: number, y: number) => y * cols + x;
    const cx = (i: number) => (i % cols) + 0.5;
    const cy = (i: number) => Math.floor(i / cols) + 0.5;
    const heuristic = (i: number, goalI: number) =>
      Math.abs((i % cols) - (goalI % cols)) + Math.abs(Math.floor(i / cols) - Math.floor(goalI / cols));

    function neighbors(i: number): number[] {
      const x = i % cols;
      const y = Math.floor(i / cols);
      const out: number[] = [];
      if (x > 0) out.push(i - 1);
      if (x < cols - 1) out.push(i + 1);
      if (y > 0) out.push(i - cols);
      if (y < rows - 1) out.push(i + cols);
      return out;
    }

    function resize() {
      dpr = Math.min(window.devicePixelRatio || 1, 2);
      w = canvas!.clientWidth;
      h = canvas!.clientHeight;
      canvas!.width = Math.floor(w * dpr);
      canvas!.height = Math.floor(h * dpr);
      ctx.setTransform(dpr, 0, 0, dpr, 0, 0);
      cols = Math.max(4, Math.ceil(w / CELL));
      rows = Math.max(4, Math.ceil(h / CELL));
      regenerate();
    }

    function regenerate() {
      const n = cols * rows;
      walls = new Uint8Array(n);
      gScore = new Float64Array(n);
      fScore = new Float64Array(n);
      cameFrom = new Int32Array(n).fill(-1);
      state = new Uint8Array(n);

      for (let i = 0; i < n; i++) walls[i] = Math.random() < 0.22 ? 1 : 0;

      const midRow = () => 1 + Math.floor(Math.random() * (rows - 2));
      start = idx(0, midRow());
      goal = idx(cols - 1, midRow());
      walls[start] = 0;
      walls[goal] = 0;

      closedOrder = [];
      openSet = [start];
      gScore[start] = 0;
      fScore[start] = heuristic(start, goal);
      state[start] = 1;
      path = [];
      revealed = 0;
      hold = 0;
      phase = "search";
    }

    function searchStep() {
      if (openSet.length === 0) {
        // no route through this maze — hold briefly, then try a new one
        phase = "hold";
        hold = HOLD_FRAMES;
        return;
      }
      let bestI = 0;
      for (let i = 1; i < openSet.length; i++) {
        if (fScore[openSet[i]!]! < fScore[openSet[bestI]!]!) bestI = i;
      }
      const current = openSet.splice(bestI, 1)[0]!;
      state[current] = 2;
      closedOrder.push(current);

      if (current === goal) {
        let n = current;
        while (n !== -1) {
          path.push(n);
          n = cameFrom[n]!;
        }
        path.reverse();
        phase = "path";
        return;
      }

      for (const nb of neighbors(current)) {
        if (walls[nb] || state[nb] === 2) continue;
        const tentative = gScore[current]! + 1;
        if (state[nb] !== 1 || tentative < gScore[nb]!) {
          cameFrom[nb] = current;
          gScore[nb] = tentative;
          fScore[nb] = tentative + heuristic(nb, goal);
          if (state[nb] !== 1) {
            state[nb] = 1;
            openSet.push(nb);
          }
        }
      }
    }

    function draw() {
      ctx.clearRect(0, 0, w, h);

      // walls: faint outline squares, just enough to read as a maze
      ctx.strokeStyle = `rgba(${GRAPH}, 0.1)`;
      ctx.lineWidth = 1;
      for (let i = 0; i < walls.length; i++) {
        if (!walls[i]) continue;
        ctx.strokeRect(cx(i) * CELL - 8, cy(i) * CELL - 8, 16, 16);
      }

      // visited cells: small closed-frontier dots
      ctx.fillStyle = `rgba(${GRAPH}, 0.35)`;
      for (const i of closedOrder) {
        ctx.beginPath();
        ctx.arc(cx(i) * CELL, cy(i) * CELL, 1.6, 0, Math.PI * 2);
        ctx.fill();
      }

      // open frontier: slightly brighter
      ctx.fillStyle = `rgba(${ACCENT}, 0.3)`;
      for (const i of openSet) {
        ctx.beginPath();
        ctx.arc(cx(i) * CELL, cy(i) * CELL, 1.8, 0, Math.PI * 2);
        ctx.fill();
      }

      // path so far: connected route in the accent colour
      const shown = path.slice(0, revealed);
      if (shown.length > 1) {
        ctx.strokeStyle = `rgba(${ACCENT}, 0.55)`;
        ctx.lineWidth = 1.6;
        ctx.beginPath();
        ctx.moveTo(cx(shown[0]!) * CELL, cy(shown[0]!) * CELL);
        for (const i of shown.slice(1)) ctx.lineTo(cx(i) * CELL, cy(i) * CELL);
        ctx.stroke();
      }

      // start / goal markers
      for (const [node, filled] of [[start, false] as const, [goal, true] as const]) {
        ctx.beginPath();
        ctx.arc(cx(node) * CELL, cy(node) * CELL, 3.2, 0, Math.PI * 2);
        if (filled) {
          ctx.fillStyle = `rgba(${ACCENT}, 0.7)`;
          ctx.fill();
        } else {
          ctx.strokeStyle = `rgba(${ACCENT}, 0.7)`;
          ctx.lineWidth = 1.4;
          ctx.stroke();
        }
      }
    }

    function tick() {
      if (phase === "search") {
        for (let s = 0; s < STEPS_PER_FRAME && phase === "search"; s++) searchStep();
      } else if (phase === "path") {
        revealed += PATH_REVEAL_PER_FRAME;
        if (revealed >= path.length) {
          revealed = path.length;
          phase = "hold";
          hold = HOLD_FRAMES;
        }
      } else {
        hold--;
        if (hold <= 0) regenerate();
      }
      draw();
    }

    let raf = 0;
    function loop() {
      tick();
      raf = requestAnimationFrame(loop);
    }

    resize();

    if (reduceMotion) {
      // run one full search synchronously and draw the static result
      while (phase === "search") searchStep();
      revealed = path.length;
      draw();
    } else {
      loop();
      document.addEventListener("visibilitychange", () => {
        if (document.hidden) cancelAnimationFrame(raf);
        else raf = requestAnimationFrame(loop);
      });
    }

    window.addEventListener("resize", () => {
      resize();
      if (reduceMotion) {
        while (phase === "search") searchStep();
        revealed = path.length;
        draw();
      }
    });
  }
</script>
