---
import "@fontsource-variable/inter";
import "@fontsource-variable/space-grotesk";
import "@fontsource/jetbrains-mono/400.css";
import "@fontsource/jetbrains-mono/500.css";
import "@/styles/global.css";
import Nav from "@/components/Nav.astro";
import Footer from "@/components/Footer.astro";
import Loader from "@/components/Loader.astro";
import { site } from "@/data/site";

interface Props {
  title?: string;
  description?: string;
  /** Intro animation — home page only, and only once per session. */
  loader?: boolean;
  /** Settle the scroll on section starts (the home page). */
  snap?: boolean;
}

const { title, description = site.description, loader = false, snap = false } = Astro.props;
const pageTitle = title ? `${title} — ${site.name}` : `${site.name} — ${site.role}`;
const canonical = new URL(Astro.url.pathname, Astro.site);
const ogImage = new URL("/og.png", Astro.site);
---

<!doctype html>
<html lang="en" class:list={[{ "snap-sections": snap }]}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{pageTitle}</title>
    <meta name="description" content={description} />
    <meta name="author" content={site.name} />
    <link rel="canonical" href={canonical} />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="sitemap" href="/sitemap-index.xml" />
    <meta name="theme-color" content="#12141b" />
    <meta property="og:type" content="website" />
    <meta property="og:title" content={pageTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:site_name" content={site.name} />
    <meta property="og:image" content={ogImage} />
    <meta property="og:image:width" content="2400" />
    <meta property="og:image:height" content="1260" />
    <meta property="og:image:alt" content={`${site.name} — ${site.tagline}`} />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:image" content={ogImage} />
    <script is:inline>
      // Mark JS availability before first paint so reveal styles apply cleanly.
      document.documentElement.classList.add("has-js");
    </script>
  </head>
  <body>
    {loader && <Loader />}

    <a
      href="#main"
      class="font-mono text-sm bg-accent fixed top-4 left-4 z-[100] -translate-y-24 rounded px-4 py-2 text-black transition-transform focus:translate-y-0"
    >
      Skip to content
    </a>

    <Nav />

    <div id="main" class="relative z-[1] mx-auto max-w-screen-xl px-6 sm:px-12 md:px-24">
      <slot />
      <Footer />
    </div>

    <script>
      // Scroll-reveal: observe [data-reveal] elements once, then unobserve.
      const els = document.querySelectorAll<HTMLElement>("[data-reveal]");
      if ("IntersectionObserver" in window) {
        const io = new IntersectionObserver(
          (entries) => {
            for (const e of entries) {
              if (e.isIntersecting) {
                e.target.classList.add("is-visible");
                io.unobserve(e.target);
              }
            }
          },
          { rootMargin: "0px 0px -10% 0px", threshold: 0.05 },
        );
        els.forEach((el) => io.observe(el));
      } else {
        els.forEach((el) => el.classList.add("is-visible"));
      }

      // Section paging, on the home page, on desktops (a mouse or trackpad
      // and a window of at least 1024×600), without reduced motion. One
      // gesture moves one section, in one smooth glide: a wheel notch or a
      // trackpad swipe at the end of a section takes you to the start of the
      // next one, and back. A section taller than the window scrolls
      // normally inside and stops at its end; the next gesture moves on. The
      // rest of the gesture that started a glide (a trackpad's momentum, a
      // wheel still spinning) is swallowed, so nothing skips a section.
      // Phones and tablets keep their native scrolling: nothing fits one
      // screen there, and paging would only get in the way.
      if (
        document.documentElement.classList.contains("snap-sections") &&
        window.matchMedia("(pointer: fine) and (min-width: 1024px) and (min-height: 600px)").matches &&
        !window.matchMedia("(prefers-reduced-motion: reduce)").matches
      ) {
        type Page = { s: number; e: number };
        // Each section is a page from s, where it lands (its heading just
        // under the nav), to e, where its content's end, plus some air, meets
        // the bottom of the window. A page that fits has e = s.
        const pages = (): Page[] => {
          const vh = innerHeight;
          const max = document.documentElement.scrollHeight - vh;
          const list = Array.from(document.querySelectorAll<HTMLElement>("#main > section"), (el) => {
            const cs = getComputedStyle(el);
            const top = el.getBoundingClientRect().top + scrollY;
            const s = Math.max(0, top - parseFloat(cs.scrollMarginTop));
            const end = top + el.offsetHeight - parseFloat(cs.paddingBottom) + 32;
            // a page only a little too tall counts as fitting: no point
            // spending a gesture on a few dozen pixels of air
            return { s, e: end - vh - s < 64 ? s : end - vh };
          });
          // the last page runs to the bottom, footer included
          const last = list[list.length - 1];
          if (last) last.e = Math.max(last.s, max);
          return list.map((p) => ({ s: Math.round(Math.min(p.s, max)), e: Math.round(Math.min(p.e, max)) }));
        };

        // What a scroll of dy should do from here: glide to another page,
        // glide or stop at this page's edge, or nothing (let the browser
        // scroll). When the rest of a page is short (a section a little
        // taller than the window), one gesture glides over all of it rather
        // than taking two or three wheel notches to get there.
        const decide = (dy: number): { glide?: number; clamp?: number } | null => {
          const ps = pages();
          const y = scrollY;
          const short = innerHeight / 3;
          let i = 0;
          for (let k = 0; k < ps.length; k++) if (ps[k].s <= y + 2) i = k;
          const p = ps[i];
          if (dy > 0) {
            if (y >= p.e - 2) return ps[i + 1] ? { glide: ps[i + 1].s } : null;
            if (p.e - y <= short) return { glide: p.e };
            if (y + dy > p.e) return { clamp: p.e };
          } else if (dy < 0) {
            if (y > p.e + 2) return { glide: p.e };
            if (y <= p.s + 2) return ps[i - 1] ? { glide: ps[i - 1].e } : null;
            if (y - p.s <= short) return { glide: p.s };
            if (y + dy < p.s) return { clamp: p.s };
          }
          return null;
        };

        let gliding = false;
        let settling = false; // swallowing the end of the gesture that started a glide
        let lastWheel = 0;
        let pending = 0; // small trackpad deltas, summed until they mean it

        const ease = (t: number) => (t < 0.5 ? 4 * t * t * t : 1 - Math.pow(-2 * t + 2, 3) / 2);
        const glide = (to: number) => {
          const from = scrollY;
          const dist = to - from;
          if (Math.abs(dist) < 1) return;
          const dur = Math.min(900, 450 + Math.abs(dist) * 0.25);
          const t0 = performance.now();
          gliding = true;
          const tick = (now: number) => {
            const k = Math.min(1, (now - t0) / dur);
            window.scrollTo({ top: from + dist * ease(k), behavior: "instant" });
            if (k < 1) requestAnimationFrame(tick);
            else {
              gliding = false;
              settling = true;
            }
          };
          requestAnimationFrame(tick);
        };

        // Something under the pointer that scrolls vertically itself gets the
        // wheel first.
        const scrollsItself = (el: Element | null, dy: number) => {
          for (; el && el !== document.body && el !== document.documentElement; el = el.parentElement) {
            if (!/(auto|scroll)/.test(getComputedStyle(el).overflowY) || el.scrollHeight <= el.clientHeight + 1) continue;
            if (dy > 0 ? el.scrollTop + el.clientHeight < el.scrollHeight - 1 : el.scrollTop > 0) return true;
          }
          return false;
        };

        window.addEventListener(
          "wheel",
          (e) => {
            if (e.ctrlKey || Math.abs(e.deltaX) > Math.abs(e.deltaY)) return; // zoom, or sideways
            const now = performance.now();
            const gap = now - lastWheel;
            lastWheel = now;
            if (gliding) return e.preventDefault();
            if (settling) {
              if (gap < 200) return e.preventDefault();
              settling = false;
            }
            if (scrollsItself(e.target as Element, e.deltaY)) return;
            const dy = e.deltaMode === 1 ? e.deltaY * 16 : e.deltaMode === 2 ? e.deltaY * innerHeight : e.deltaY;
            if (gap > 200) pending = 0;
            const to = decide(dy);
            if (!to) return;
            e.preventDefault();
            if (to.clamp !== undefined) return window.scrollTo({ top: to.clamp, behavior: "instant" });
            pending += dy;
            if (Math.abs(pending) < 25) return;
            pending = 0;
            glide(to.glide!);
          },
          { passive: false },
        );

        // PageDown, PageUp and the space bar page the same way.
        window.addEventListener("keydown", (e) => {
          if (e.defaultPrevented || e.altKey || e.ctrlKey || e.metaKey) return;
          if ((e.target as Element).closest("input, textarea, select, button, a, summary, [contenteditable], [role=tab]")) return;
          const dir = e.key === "PageDown" || (e.key === " " && !e.shiftKey) ? 1 : e.key === "PageUp" || (e.key === " " && e.shiftKey) ? -1 : 0;
          if (!dir) return;
          if (gliding) return e.preventDefault();
          const to = decide(dir * innerHeight * 0.85);
          if (!to) return;
          e.preventDefault();
          if (to.clamp !== undefined) window.scrollTo({ top: to.clamp, behavior: "smooth" });
          else glide(to.glide!);
        });
      }
    </script>
  </body>
</html>
