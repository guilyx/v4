---
import "@fontsource-variable/inter";
import "@fontsource-variable/space-grotesk";
import "@fontsource/jetbrains-mono/400.css";
import "@fontsource/jetbrains-mono/500.css";
import "@/styles/global.css";
import Nav from "@/components/Nav.astro";
import Footer from "@/components/Footer.astro";
import Loader from "@/components/Loader.astro";
import { site } from "@/data/site";

interface Props {
  title?: string;
  description?: string;
  /** Intro animation — home page only, and only once per session. */
  loader?: boolean;
  /** Settle the scroll on section starts (the home page). */
  snap?: boolean;
}

const { title, description = site.description, loader = false, snap = false } = Astro.props;
const pageTitle = title ? `${title} — ${site.name}` : `${site.name} — ${site.role}`;
const canonical = new URL(Astro.url.pathname, Astro.site);
const ogImage = new URL("/og.png", Astro.site);
---

<!doctype html>
<html lang="en" class:list={[{ "snap-sections": snap }]}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{pageTitle}</title>
    <meta name="description" content={description} />
    <meta name="author" content={site.name} />
    <link rel="canonical" href={canonical} />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="sitemap" href="/sitemap-index.xml" />
    <meta name="theme-color" content="#12141b" />
    <meta property="og:type" content="website" />
    <meta property="og:title" content={pageTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:site_name" content={site.name} />
    <meta property="og:image" content={ogImage} />
    <meta property="og:image:width" content="2400" />
    <meta property="og:image:height" content="1260" />
    <meta property="og:image:alt" content={`${site.name} — ${site.tagline}`} />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:image" content={ogImage} />
    <script is:inline>
      // Mark JS availability before first paint so reveal styles apply cleanly.
      document.documentElement.classList.add("has-js");
    </script>
  </head>
  <body>
    {loader && <Loader />}

    <a
      href="#main"
      class="font-mono text-sm bg-accent fixed top-4 left-4 z-[100] -translate-y-24 rounded px-4 py-2 text-black transition-transform focus:translate-y-0"
    >
      Skip to content
    </a>

    <Nav />

    <div id="main" class="relative z-[1] mx-auto max-w-screen-xl px-6 sm:px-12 md:px-24">
      <slot />
      <Footer />
    </div>

    <script>
      // Scroll-reveal: observe [data-reveal] elements once, then unobserve.
      const els = document.querySelectorAll<HTMLElement>("[data-reveal]");
      if ("IntersectionObserver" in window) {
        const io = new IntersectionObserver(
          (entries) => {
            for (const e of entries) {
              if (e.isIntersecting) {
                e.target.classList.add("is-visible");
                io.unobserve(e.target);
              }
            }
          },
          { rootMargin: "0px 0px -10% 0px", threshold: 0.05 },
        );
        els.forEach((el) => io.observe(el));
      } else {
        els.forEach((el) => el.classList.add("is-visible"));
      }

      // Section snapping, on the home page only. CSS scroll snapping was
      // either too loose (proximity: it only snapped when a scroll happened
      // to stop near a section) or too sticky (mandatory: a short scroll,
      // like one mouse-wheel notch, snapped straight back to where it
      // started). This goes by direction instead: when a scroll comes to
      // rest, glide on to the next section's start (or back to this one's)
      // if the section fits on screen, or once that start is in the near
      // half of the screen. Inside a taller section the page scrolls freely.
      if (
        document.documentElement.classList.contains("snap-sections") &&
        !window.matchMedia("(prefers-reduced-motion: reduce)").matches
      ) {
        const stops = () => {
          const max = document.documentElement.scrollHeight - innerHeight;
          const ys = Array.from(document.querySelectorAll<HTMLElement>("#main > section"), (s) => {
            return s.getBoundingClientRect().top + scrollY - parseFloat(getComputedStyle(s).scrollMarginTop);
          });
          ys.push(max); // the footer
          return ys.map((y) => Math.round(Math.max(0, Math.min(max, y)))).sort((a, b) => a - b);
        };

        let rest = scrollY; // where the last scroll came to rest
        let gliding = false; // the scroll in progress is ours
        let focusedAt = 0;
        let touching = false;

        const settle = () => {
          const y = scrollY;
          if (gliding) {
            gliding = false;
            rest = y;
            return;
          }
          // a scroll that brought a focused element into view stays put
          const dir = Math.sign(y - rest);
          if (!dir || performance.now() - focusedAt < 600) {
            rest = y;
            return;
          }
          const vh = innerHeight;
          const s = stops();
          const prev = s.filter((p) => p <= y + 1).pop() ?? 0;
          const next = s.find((p) => p > y + 1);
          const fits = next !== undefined && next - prev <= vh + 2;
          let to: number | null = null;
          if (dir > 0 && next !== undefined && (fits || next - y <= vh / 2)) to = next;
          if (dir < 0 && (fits || y - prev <= vh / 2)) to = prev;
          if (to === null || Math.abs(to - y) < 2) {
            rest = y;
            return;
          }
          gliding = true;
          window.scrollTo({ top: to, behavior: "smooth" });
        };

        document.addEventListener("focusin", () => (focusedAt = performance.now()));
        if ("onscrollend" in window) {
          window.addEventListener("scrollend", settle);
        } else {
          // Older Safari: call it settled 150ms after the last scroll event,
          // and never while a finger is still on the screen.
          let timer = 0;
          const later = () => {
            clearTimeout(timer);
            timer = window.setTimeout(() => !touching && settle(), 150);
          };
          window.addEventListener("scroll", later, { passive: true });
          window.addEventListener("touchstart", () => (touching = true), { passive: true });
          window.addEventListener("touchend", () => ((touching = false), later()), { passive: true });
        }
      }
    </script>
  </body>
</html>
