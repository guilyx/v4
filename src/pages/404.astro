---
import Base from "@/layouts/Base.astro";
---

<Base title="404">
  <div class="flex min-h-screen flex-col items-center justify-center text-center">
    <p class="font-mono text-accent text-sm">// lost signal</p>
    <h1 class="mt-4 text-7xl font-semibold sm:text-8xl">404</h1>
    <p class="text-muted mt-4 max-w-sm">
      This agent wandered off the flock. The page you're looking for doesn't exist.
    </p>
    <a href="/" class="btn mt-10">Return home</a>
  </div>
</Base>
